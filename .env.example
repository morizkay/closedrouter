# ClosedRouter environment
# Copy to .env and adjust.

# Bind address for the gateway. Render/Docker set PORT automatically.
HOST=0.0.0.0
PORT=8080

# SQLite database path (directory is created if missing)
DATABASE_PATH=./data/closedrouter.db

# Dashboard admin secret. If unset, a token is generated and stored in SQLite.
ADMIN_TOKEN=change-me-now

# Optional YAML config (providers/models seed on first boot)
# CLOSEDROUTER_CONFIG=./config.yaml

# Comma-separated browser origins, or * to allow all
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# info, debug, warn — JSON logs with LOG_FORMAT=json
RUST_LOG=info
# LOG_FORMAT=json

# Dashboard (browser) URL of the gateway
PUBLIC_GATEWAY_URL=http://localhost:8080
