# ClosedRouter environment
# Copy to .env and adjust.

# Bind address for the gateway. Render/Docker set PORT automatically.
HOST=0.0.0.0
PORT=8080

# PostgreSQL + pgvector (required)
DATABASE_URL=postgres://closedrouter:closedrouter@localhost:5432/closedrouter
POSTGRES_USER=closedrouter
POSTGRES_PASSWORD=closedrouter
POSTGRES_DB=closedrouter

# Required for Docker Compose (gateway publishes :8080). The gateway refuses
# empty values and the public example `change-me-now`.
#   openssl rand -hex 24
ADMIN_TOKEN=

# Optional YAML config (providers/models seed on first boot)
# CLOSEDROUTER_CONFIG=./config.yaml

# Comma-separated browser origins, or * to allow all (needed for Cursor in-browser calls)
CORS_ORIGINS=*

# Catalog model id used when Hermes sets embed=true
# EMBEDDING_MODEL=text-embedding-3-small

# Bounded request_logs table
REQUEST_LOG_LIMIT=10000

# info, debug, warn — JSON logs with LOG_FORMAT=json
RUST_LOG=info
# LOG_FORMAT=json

# Dashboard (browser) URL of the gateway
PUBLIC_GATEWAY_URL=http://localhost:8080

# Optional Langfuse export (compose profile `full` runs a local Langfuse)
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
NEXTAUTH_SECRET=closedrouter-nextauth-secret-change-me-please
LANGFUSE_SALT=closedrouter-langfuse-salt-change-me
GRAFANA_ADMIN_PASSWORD=admin
