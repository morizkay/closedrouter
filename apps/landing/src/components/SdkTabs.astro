---
import { SDK_TABS, SNIPPETS, type TabId } from '../lib/content';

const firstTab: TabId = 'openai';
---

<section id="sdk" class="site-container pb-24">
	<p class="section-kicker">SDKs</p>
	<div class="mt-3 flex flex-wrap items-end justify-between gap-5">
		<h2 class="section-title">Point existing clients at it.</h2><p
			class="max-w-xs text-sm leading-6 text-mist"
		>
			Choose an adapter to get the exact base URL and starter config.
		</p>
	</div>
	<div class="panel mt-8 overflow-hidden" data-sdk-root>
		<div
			class="flex flex-wrap gap-1 border-b border-line bg-white/[0.02] p-3"
			role="tablist"
			aria-label="Client integrations"
		>
			{
				SDK_TABS.map((tab) => (
					<button
						type="button"
						data-sdk-tab={tab.id}
						role="tab"
						aria-selected={tab.id === firstTab ? 'true' : 'false'}
						aria-controls={`sdk-panel-${tab.id}`}
						class:list={[
							'rounded-lg px-3 py-2 text-sm',
							tab.id === firstTab
								? 'bg-acid text-ink'
								: 'text-mist hover:bg-white/5 hover:text-paper'
						]}
					>
						{tab.label}
					</button>
				))
			}
		</div>
		{
			SDK_TABS.map((tab) => (
				<pre
					data-sdk-panel={tab.id}
					id={`sdk-panel-${tab.id}`}
					role="tabpanel"
					aria-label={`${tab.label} code example`}
					hidden={tab.id !== firstTab}
					class="min-h-64 overflow-x-auto p-6 font-mono text-[12px] leading-6 text-paper/90 sm:text-[13px]"
				>
					{SNIPPETS[tab.id]}
				</pre>
			))
		}
	</div>
</section>

<script>
	const TAB_IDS = ['openai', 'anthropic', 'deepseek', 'glm', 'cursor'] as const;
	type TabId = (typeof TAB_IDS)[number];

	function isTabId(value: string): value is TabId {
		return (TAB_IDS as readonly string[]).includes(value);
	}

	const ACTIVE = 'bg-acid text-ink';
	const INACTIVE = 'text-mist hover:text-paper';

	function setPressed(button: HTMLButtonElement, active: boolean): void {
		button.setAttribute('aria-selected', active ? 'true' : 'false');
		button.className = `rounded-lg px-3 py-2 text-sm ${active ? ACTIVE : INACTIVE}`;
	}

	function showTab(root: HTMLElement, tab: TabId): void {
		const buttons = root.querySelectorAll<HTMLButtonElement>('[data-sdk-tab]');
		for (const button of buttons) {
			const id = button.dataset.sdkTab;
			if (!id || !isTabId(id)) continue;
			setPressed(button, id === tab);
		}

		const panels = root.querySelectorAll<HTMLElement>('[data-sdk-panel]');
		for (const panel of panels) {
			const id = panel.dataset.sdkPanel;
			if (!id || !isTabId(id)) continue;
			panel.hidden = id !== tab;
		}
	}

	function bindRoot(root: HTMLElement): void {
		root.addEventListener('click', (event: MouseEvent) => {
			const target = event.target;
			if (!(target instanceof HTMLElement)) return;
			const button = target.closest<HTMLButtonElement>('[data-sdk-tab]');
			if (!button) return;
			const id = button.dataset.sdkTab;
			if (!id || !isTabId(id)) return;
			showTab(root, id);
		});
	}

	const roots = document.querySelectorAll<HTMLElement>('[data-sdk-root]');
	for (const root of roots) {
		bindRoot(root);
	}
</script>
