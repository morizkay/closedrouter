---
import { DOCKER_SNIPPET } from '../lib/content';
---

<section id="docker" class="site-container pb-24">
	<div
		class="panel grid items-center gap-10 overflow-hidden p-6 sm:p-8 md:grid-cols-[0.9fr_1.1fr] md:p-10"
	>
		<div>
			<p class="section-kicker">Deploy</p>
			<h2 class="mt-4 text-3xl font-extrabold tracking-[-0.06em] md:text-4xl">
				Your gateway in one compose file.
			</h2>
			<p class="mt-4 text-sm leading-7 text-mist">
				Rust gateway, React admin, Postgres + pgvector. Start slim on <code
					class="font-mono text-acid">8080/3000</code
				>, or bring up the full observability stack when you need it.
			</p>
			<div class="mt-7 flex flex-wrap gap-3">
				<a href="https://github.com/morizkay/closedrouter" class="button-primary px-4 py-3"
					>View on GitHub</a
				><a href="#sdk" class="button-secondary px-4 py-3">Read the API examples</a>
			</div>
		</div>
		<div class="overflow-hidden rounded-xl border border-line bg-black/25">
			<div class="flex items-center justify-between border-b border-line px-4 py-3">
				<span class="font-mono text-[10px] tracking-[0.14em] text-mist uppercase">Terminal</span
				><span class="font-mono text-[10px] text-acid">docker compose</span>
			</div>
			<pre
				class="overflow-x-auto p-5 font-mono text-[12px] leading-6 text-paper/90">{DOCKER_SNIPPET}</pre>
		</div>
	</div>
</section>
