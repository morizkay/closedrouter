---
import { HOW_STEPS } from '../lib/content';
---

<section id="how" class="site-container pb-24">
	<p class="section-kicker">How it works</p>
	<div class="mt-3 flex flex-wrap items-end justify-between gap-5">
		<h2 class="section-title max-w-xl">One front door.<br />Many upstreams.</h2><p
			class="max-w-xs text-sm leading-6 text-mist"
		>
			Your clients get one stable API. You decide what happens behind it.
		</p>
	</div>
	<ol class="mt-10 grid gap-4 md:grid-cols-3">
		{
			HOW_STEPS.map((step) => (
				<li class="panel relative p-6">
					<div class="flex items-center justify-between">
						<>
							<div class="flex h-9 w-9 items-center justify-center rounded-lg bg-acid font-mono text-sm font-medium text-ink">
								{step.n}
							</div>
							<span class="font-mono text-[10px] tracking-[0.14em] text-mist uppercase">
								step {step.n}
							</span>
						</>
					</div>
					<h3 class="mt-8 text-lg font-bold tracking-[-0.03em]">{step.t}</h3>
					<p class="mt-2 text-sm text-mist">{step.d}</p>
				</li>
			))
		}
	</ol>
</section>
