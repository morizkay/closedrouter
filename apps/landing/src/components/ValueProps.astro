---
import { VALUE_PROPS } from '../lib/content';
---

<section class="site-container pb-24">
	<div class="mb-8 max-w-xl">
		<p class="section-kicker">Why ClosedRouter</p>
		<h2 class="mt-3 text-2xl font-extrabold tracking-[-0.05em] sm:text-3xl">
			Own the path between your app and the model.
		</h2>
	</div>
	<div class="grid gap-4 md:grid-cols-3">
		{
			VALUE_PROPS.map((item, index) => (
				<div class="panel group p-5 transition-transform duration-200 hover:-translate-y-1">
					<div class="flex items-center justify-between">
						<>
							<p class="font-mono text-xs text-acid">{item.k}</p>
							<span class="font-mono text-[10px] text-mist">0{index + 1}</span>
						</>
					</div>
					<h2 class="mt-6 text-lg font-bold tracking-[-0.03em]">{item.t}</h2>
					<p class="mt-2 text-sm leading-relaxed text-mist">{item.d}</p>
				</div>
			))
		}
	</div>
</section>
